#!/bin/sh

# The famous "get a menu of emojis to copy" script.
# Shamelessly copied from lukesmithxyz's LARBS
# https://github.com/LukeSmithxyz/voidrice/blob/master/.local/bin/dmenuunicode

# Must have xclip installed to even show menu.
xclip -h 2>/dev/null || exit 1

emoji_file="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/emoji"
chosen=$(cut -d ';' -f1 "$emoji_file" | dmenu -i -l 20 | sed "s/ .*//")

[ "$chosen" != "" ] || exit

# If you run this command with an argument, it will automatically insert the character.
if command -v xdotool >/dev/null 2>&1; then
	xdotool type "$chosen"
else
	echo "$chosen" | tr -d '\n' | xclip -selection clipboard
	notify-send "'$chosen' copied to clipboard." &
fi
